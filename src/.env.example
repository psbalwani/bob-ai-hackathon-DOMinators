# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai (used by src/detection/llm_hook.py for the ambiguous
# late-visit severity case; everything else works without these set)
WATSONX_API_KEY=your_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Prefer WATSONX_SPACE_ID (a deployment space with a WML instance attached).
# WATSONX_PROJECT_ID works only if that project itself has a WML instance
# associated -- otherwise watsonx.ai calls 403 with "not associated with a
# WML instance" even though the project/key are both valid.
WATSONX_SPACE_ID=your_space_id_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Database (if used)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Application
APP_PORT=8000
APP_ENV=development

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Add your project-specific variables below
